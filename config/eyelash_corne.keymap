#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10
#define ZMK_POINTING_SLOW_MOVE_VAL 300
#define SLOW_UP    MOVE_Y(-ZMK_POINTING_SLOW_MOVE_VAL)
#define SLOW_DOWN  MOVE_Y(ZMK_POINTING_SLOW_MOVE_VAL)
#define SLOW_LEFT  MOVE_X(-ZMK_POINTING_SLOW_MOVE_VAL)
#define SLOW_RIGHT MOVE_X(ZMK_POINTING_SLOW_MOVE_VAL)

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_scrl: rsr_scrl {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <100>;
            cw-binding = <&msc SCRL_UP>;
            ccw-binding = <&msc SCRL_DOWN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

   combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
  &kp ESC          &kp Q            &kp W            &kp E            &kp R            &kp T            &mmv MOVE_UP     &kp Y            &kp U            &kp I            &kp O            &kp P            &kp RCTRL
  &mo 1            &kp A            &kp S            &kp D            &kp F            &kp G            &mmv MOVE_LEFT   &kp RBKT         &mmv MOVE_RIGHT  &kp H            &kp J            &kp K            &kp L            &kp SEMI         &kp SQT
  &kp LGUI         &kp Z            &kp X            &kp C            &kp V            &kp B            &kp LBKT         &mmv MOVE_DOWN   &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH         &kp RSHFT
  &kp LCTRL        &kp BSPC         &kp DEL          &kp RET          &lt 2 SPACE      &mo 3
            >;

            sensor-bindings = <&rsr_scrl &rsr_trans>;
        };

        layer_1 {
            display-name = "NAV";
            bindings = <
  &kp TAB            &kp LC(LALT)       &kp LC(LGUI)       &kp LG(LALT)       &kp LS(LG(UP))     &kp LS(LG(DOWN))   &mmv SLOW_UP       &kp N1             &kp HOME           &kp PG_DN          &kp PG_UP          &kp END            &kp EQUAL
  &kp TAB            &kp LCTRL          &kp LGUI           &kp LALT           &kp LS(LG(LEFT))   &kp LS(LG(RIGHT))  &mmv SLOW_LEFT     &mkp LCLK          &mmv SLOW_RIGHT    &kp LS(SEMI)       &kp LEFT           &kp DOWN           &kp UP             &kp RIGHT          &kp MINUS
  &kp RSHFT          &kp LG(Z)          &kp LG(X)          &kp LG(C)          &kp LG(V)          &kp LG(Y)          &kp LS(KP_ENTER)   &mmv SLOW_DOWN     &kp FSLH           &kp LBKT           &kp LS(MINUS)      &kp LS(EQUAL)      &kp RBKT           &kp RSHFT
  &kp LG(SPACE)      &kp RSHFT          &kp LALT           &kp RSHFT          &kp TAB            &trans
            >;

            sensor-bindings = <&rsr_scrl &rsr_trans>;
        };

        layer_2 {
            display-name = "NUMBER";
            bindings = <
  &kp TAB        &kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &trans         &kp N6         &kp N7         &kp N8         &kp N9         &kp N0         &kp LS(EQUAL)
  &kp TAB        &kp LS(N1)     &kp LS(N2)     &kp LS(N3)     &kp LS(N4)     &kp LS(N5)     &trans         &mkp LCLK      &mkp RCLK      &kp LS(N6)     &kp LS(N7)     &kp LS(N8)     &kp LS(N9)     &kp LS(N0)     &kp MINUS
  &kp LSHFT      &kp F1         &kp F2         &kp F3         &kp F4         &kp F5         &trans         &trans         &kp F6         &kp F7         &kp F8         &kp F9         &kp F10        &kp RSHFT
  &trans         &kp BSPC       &kp DEL        &kp RET        &trans         &trans
            >;

            sensor-bindings = <&rsr_scrl &rsr_trans>;
        };

        layer_3 {
            display-name = "SYMBOL";
            bindings = <
  &kp TAB          &kp LS(N1)       &kp LS(N2)       &kp LS(N3)       &kp LS(N4)       &kp LS(N5)       &trans           &kp LS(LBKT)     &kp LBKT         &kp LS(N9)       &kp LS(N0)       &kp RBKT         &kp LS(RBKT)
  &trans           &trans           &trans           &trans           &trans           &trans           &trans           &kp LS(N5)       &kp LS(SEMI)     &kp KP_PLUS      &kp KP_MULTIPLY  &kp LS(MINUS)    &kp MINUS        &kp KP_DIVIDE    &kp KP_EQUAL
  &kp LSHFT        &kp K_UNDO       &kp K_CUT        &kp K_COPY       &kp K_PASTE      &kp K_AGAIN      &trans           &trans           &kp LS(N7)       &kp GRAVE        &kp BSLH         &kp FSLH         &kp LS(N1)       &kp LS(N6)
  &trans           &trans           &trans           &kp RET          &trans           &trans
            >;

            sensor-bindings = <&rsr_scrl &rsr_trans>;
        };
    };
};
